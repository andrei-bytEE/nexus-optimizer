<UserControl x:Class="NexusOptimizer.Views.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,0,0,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" Foreground="#EDE9F5"/>
            <TextBlock x:Name="SubtitleText" FontSize="13" Foreground="#9A92AD"
                       TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <ContentPresenter x:Name="ActionArea" Grid.Column="1"
                          VerticalAlignment="Center" Margin="16,0,0,0"/>
    </Grid>
</UserControl>