<UserControl x:Class="NexusOptimizer.Views.LicenseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,12,0">
            <TextBlock Text="License" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Enter your license key to unlock all features on this PC."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,20"/>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Current plan" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding PlanText}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="License key" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBox Text="{Binding KeyText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="10,8" Margin="0,0,0,12"
                             Background="{StaticResource CardHoverBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource BorderBrush}"/>
                    <Button Content="Activate" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left"
                            Command="{Binding ActivateCommand}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>