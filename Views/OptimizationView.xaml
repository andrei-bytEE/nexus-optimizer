<UserControl x:Class="NexusOptimizer.Views.OptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NexusOptimizer.Views"
             Foreground="{StaticResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,12,0">
            <views:PageHeader Title="Windows Optimization"
                              Subtitle="Each change is backed up, checked after it is written, and can be undone. Preview a profile before applying it."/>

            <TextBlock Text="Profiles" Style="{StaticResource SectionTitle}"/>
            <ItemsControl ItemsSource="{Binding Profiles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource HoverCard}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}"
                                               Style="{StaticResource BodyMuted}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Preview"
                                        Style="{StaticResource SecondaryButton}"
                                        MinWidth="100" Margin="16,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding DataContext.PreviewCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                                <Button Grid.Column="2" Content="Apply"
                                        Style="{StaticResource PrimaryButton}"
                                        MinWidth="100" Margin="12,0,0,0" VerticalAlignment="Center"
                                        Command="{Binding DataContext.ApplyProfileCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Undo All" Style="{StaticResource SecondaryButton}"
                    Command="{Binding UndoAllCommand}"
                    HorizontalAlignment="Left" Margin="0,8,0,20"/>

            <TextBlock Text="Individual settings" Style="{StaticResource SectionTitle}"/>
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource HoverCard}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}"
                                               Style="{StaticResource BodyMuted}" Margin="0,4,0,6"/>
                                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}">
                                        <Run Text="{Binding Category, Mode=OneWay}"/>
                                        <Run Text=" · Risk: "/>
                                        <Run Text="{Binding Risk, Mode=OneWay}"/>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Evidence}" Style="{StaticResource BodyMuted}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding RestartText}" FontSize="12"
                                               Foreground="#C4A5FF" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding StatusText}" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding ButtonText}"
                                        Background="{Binding ButtonBrush}"
                                        Style="{StaticResource PrimaryButton}"
                                        MinWidth="120"
                                        HorizontalContentAlignment="Center"
                                        Tag="{Binding}"
                                        Click="Apply_Click"
                                        Margin="16,0,0,0"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

                        <Border Style="{StaticResource BannerBase}"
                    Background="{Binding StatusMessage, Converter={StaticResource StatusBg}}"
                    BorderBrush="{Binding StatusMessage, Converter={StaticResource StatusBorder}}">
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource BodyMuted}"
                           Foreground="#EDE9F5" FontSize="13"/>
            </Border>        
</StackPanel>
    </ScrollViewer>
</UserControl>