<UserControl x:Class="NexusOptimizer.Views.DebloatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,12,0">
            <TextBlock Text="Uninstall Apps" FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="Store apps can be ticked and removed together. Desktop programs and games use their own uninstaller."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,16"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Button Content="Uninstall Selected Store Apps" Style="{StaticResource PrimaryButton}"
                        Command="{Binding UninstallSelectedCommand}" Margin="0,0,12,0"/>
                <Button Content="Refresh" Style="{StaticResource SecondaryButton}"
                        Command="{Binding RefreshCommand}"/>
            </StackPanel>

            <TextBlock Text="Store apps" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <ItemsControl ItemsSource="{Binding StoreItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource HoverCard}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}"
                                          VerticalAlignment="Center" Margin="0,0,16,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Description}"
                                               Foreground="{StaticResource MutedBrush}"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Desktop programs and games" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,10"/>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,0,0,12" Padding="10,8"
                     Background="{StaticResource CardBrush}"
                     Foreground="{StaticResource TextBrush}"
                     BorderBrush="{StaticResource BorderBrush}"/>

            <ItemsControl ItemsSource="{Binding Programs}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource HoverCard}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Publisher}"
                                               Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Version, StringFormat=Version: {0}}"
                                               FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Uninstall"
                                        Style="{StaticResource SecondaryButton}"
                                        Command="{Binding DataContext.UninstallProgramCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        MinWidth="110" Margin="16,0,0,0"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>