<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#EDE9F5"/>
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#9A92AD"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#EDE9F5"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="BodyMuted" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#9A92AD"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#9A92AD"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,12,0,0"/>
    </Style>

    <!-- Hover card: same look as CardStyle, plus a brighter border on hover -->
    <Style x:Key="HoverCard" TargetType="Border">
        <Setter Property="Background" Value="#171321"/>
        <Setter Property="BorderBrush" Value="#2A2438"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="22"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="#4C3A6E"/>
                <Setter Property="Background" Value="#1A1526"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Status banners -->
    <Style x:Key="BannerBase" TargetType="Border">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,12,0,0"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="BannerSuccess" TargetType="Border" BasedOn="{StaticResource BannerBase}">
        <Setter Property="Background" Value="#14291F"/>
        <Setter Property="BorderBrush" Value="#30A46C"/>
    </Style>

    <Style x:Key="BannerWarning" TargetType="Border" BasedOn="{StaticResource BannerBase}">
        <Setter Property="Background" Value="#2E2612"/>
        <Setter Property="BorderBrush" Value="#E0A93B"/>
    </Style>

    <Style x:Key="BannerError" TargetType="Border" BasedOn="{StaticResource BannerBase}">
        <Setter Property="Background" Value="#2E1517"/>
        <Setter Property="BorderBrush" Value="#E5484D"/>
    </Style>

</ResourceDictionary>