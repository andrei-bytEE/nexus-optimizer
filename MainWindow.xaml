<Window x:Class="NexusOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NexusOptimizer.Views"
        xmlns:ViewModels="clr-namespace:NexusOptimizer.ViewModels"
        Title="NEXUS OPTIMIZER"
        Width="1180" Height="760" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <DataTemplate DataType="{x:Type ViewModels:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ViewModels:OptimizationViewModel}">
            <views:OptimizationView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ViewModels:ProfilesViewModel}">
            <views:ProfilesView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ViewModels:StartupViewModel}">
            <views:StartupView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ViewModels:UninstallAppsViewModel}">
            <views:DebloatView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ViewModels:PerformanceViewModel}">
            <views:PerformanceView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type ViewModels:LicenseViewModel}">
            <views:LicenseView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="18,24,18,20">

                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="6,0,0,4">
                        <Border Width="28" Height="28" Margin="0,0,10,0"
                                Background="{StaticResource NexusLogoBrush}"/>
                        <TextBlock Text="NEXUS" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="OPTIMIZER" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" Margin="6,0,0,4"/>
                    <TextBlock Text="Advanced Windows Performance Suite"
                               FontSize="11" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="6,0,0,30"/>

                    <TextBlock Text="MENU" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource MutedBrush}" Margin="8,0,0,8"/>

                    <Button x:Name="NavDashboard" Content="Dashboard"
                            Style="{StaticResource NavButton}"
                            Command="{Binding ShowDashboardCommand}" Margin="0,0,0,4"/>
                    <Button x:Name="NavPerformance" Content="Performance"
                            Style="{StaticResource NavButton}"
                            Command="{Binding ShowPerformanceCommand}" Margin="0,0,0,4"/>
                    <Button x:Name="NavOptimization" Content="Windows Optimization  (Premium)"
                            Style="{StaticResource NavButton}"
                            Command="{Binding ShowOptimizationCommand}" Margin="0,0,0,4"/>
                    <Button x:Name="NavProfiles" Content="Gaming Profile  (Premium)"
                            Style="{StaticResource NavButton}"
                            Command="{Binding ShowProfilesCommand}" Margin="0,0,0,4"/>
                    <Button x:Name="NavStartup" Content="Startup Apps"
                            Style="{StaticResource NavButton}"
                            Command="{Binding ShowStartupCommand}" Margin="0,0,0,4"/>
                    <Button x:Name="NavUninstall" Content="Uninstall Apps"
                            Style="{StaticResource NavButton}"
                            Command="{Binding ShowUninstallAppsCommand}" Margin="0,0,0,4"/>
                    <Button x:Name="NavLicense" Content="License"
                            Style="{StaticResource NavButton}"
                            Command="{Binding ShowLicenseCommand}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,14"/>
                    <TextBlock Text="Version 0.1" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="6,0,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ContentControl x:Name="ContentHost" Grid.Column="1"
                        Content="{Binding CurrentPage}" Margin="36,32,36,28">
            <ContentControl.RenderTransform>
                <TranslateTransform/>
            </ContentControl.RenderTransform>
        </ContentControl>
    </Grid>
</Window>